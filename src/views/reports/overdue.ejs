<%- include('../partials/layout-start') %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Báo Cáo Thống Kê Sách Trả Trễ</h2>
      <p class="text-xs text-slate-500">Danh sách các cuốn sách đang mượn đã vượt quá hạn hẹn trả tính đến ngày báo cáo</p>
    </div>

    <div class="flex items-center gap-2.5">
      <a href="/reports/overdue/export?date=<%= selectedDate %>"
        class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
        <i class="fa-solid fa-file-excel"></i>
        <span>Xuất Báo Cáo Excel</span>
      </a>
    </div>
  </div>

  <!-- Date Selector Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
    <form action="/reports/overdue" method="GET" class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-700">Ngày Thống Kê:</label>
        <input type="date" name="date" value="<%= selectedDate %>"
          class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:bg-white" />
      </div>

      <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold transition">
        <i class="fa-solid fa-magnifying-glass mr-1"></i> Xem Báo Cáo
      </button>

      <div class="ml-auto text-xs text-slate-500 font-medium">
        Tổng số sách trả trễ: <strong class="text-red-600 font-black text-sm"><%= report.totalOverdueItems %></strong> cuốn
      </div>
    </form>
  </div>

  <!-- Data Table (.2 Standard Format) -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h3 class="font-bold text-slate-800 text-sm">Bảng Thống Kê Sách Trả Trễ (Mẫu .2)</h3>
        <p class="text-[11px] text-slate-400">Tính đến ngày: <strong><%= selectedDate %></strong></p>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-2.5 px-3">STT</th>
            <th class="py-2.5 px-3">Mã Phiếu</th>
            <th class="py-2.5 px-3">Tên Sách</th>
            <th class="py-2.5 px-3">Mã Vạch</th>
            <th class="py-2.5 px-3">Ngày Mượn</th>
            <th class="py-2.5 px-3">Hạn Trả</th>
            <th class="py-2.5 px-3 text-center">Số Ngày Trả Trễ</th>
            <th class="py-2.5 px-3">Độc Giả</th>
            <th class="py-2.5 px-3">Điện Thoại</th>
            <th class="py-2.5 px-3 text-right">Thao Tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (report.items && report.items.length > 0) { %>
            <% report.items.forEach((item, idx) => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="py-3 px-3 text-slate-400 font-mono"><%= idx + 1 %></td>
                <td class="py-3 px-3 font-mono font-bold text-blue-600">
                  <a href="/borrow/<%= item.ticket_code %>" class="hover:underline"><%= item.ticket_code %></a>
                </td>
                <td class="py-3 px-3 font-bold text-slate-800"><%= item.book_title %></td>
                <td class="py-3 px-3 font-mono text-slate-600"><%= item.barcode %></td>
                <td class="py-3 px-3 text-slate-600"><%= item.borrow_date %></td>
                <td class="py-3 px-3 text-slate-600"><%= item.due_date %></td>
                <td class="py-3 px-3 text-center">
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-black bg-red-100 text-red-700 animate-pulse">
                    <%= item.overdue_days %> ngày
                  </span>
                </td>
                <td class="py-3 px-3 font-semibold text-slate-800">
                  <%= item.reader_name %> (<%= item.reader_code %>)
                </td>
                <td class="py-3 px-3 font-mono text-slate-600"><%= item.reader_phone || 'N/A' %></td>
                <td class="py-3 px-3 text-right">
                  <a href="/borrow/create" class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-700 rounded-lg text-xs font-semibold">
                    Thu hồi
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="10" class="py-8 text-center text-slate-400">
                <i class="fa-solid fa-circle-check text-green-500 text-2xl mb-1 block"></i>
                Không có cuốn sách nào bị trả trễ tính đến ngày <%= selectedDate %>!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
