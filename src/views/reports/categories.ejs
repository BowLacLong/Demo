<%- include('../partials/layout-start') %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Báo Cáo Tình Hình Mượn Theo Thể Loại</h2>
      <p class="text-xs text-slate-500">Thống kê số lượt mượn và tỉ lệ lưu hành của từng thể loại sách theo tháng</p>
    </div>

    <div class="flex items-center gap-2.5">
      <a href="/reports/categories/export?month=<%= selectedMonth %>&year=<%= selectedYear %>"
        class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
        <i class="fa-solid fa-file-excel"></i>
        <span>Xuất Báo Cáo Excel</span>
      </a>
    </div>
  </div>

  <!-- Month & Year Selector Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
    <form action="/reports/categories" method="GET" class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-700">Tháng:</label>
        <select name="month" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800">
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>>Tháng <%= m %></option>
          <% } %>
        </select>
      </div>

      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-slate-700">Năm:</label>
        <select name="year" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800">
          <% for (let y = new Date().getFullYear(); y >= new Date().getFullYear() - 3; y--) { %>
            <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>>Năm <%= y %></option>
          <% } %>
        </select>
      </div>

      <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold transition">
        <i class="fa-solid fa-magnifying-glass mr-1"></i> Xem Báo Cáo
      </button>

      <div class="ml-auto text-xs text-slate-500 font-medium">
        Tổng số lượt mượn trong tháng: <strong class="text-blue-600 font-black text-sm"><%= report.totalBorrows %></strong> lượt
      </div>
    </form>
  </div>

  <!-- Report Visuals & Table Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Chart Box -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
      <div>
        <h3 class="font-bold text-slate-800 text-sm mb-1">Biểu Đồ Cơ Cấu Mượn Sách</h3>
        <p class="text-[11px] text-slate-400 mb-4">Tỉ lệ phần trăm mượn theo thể loại</p>
      </div>
      <div class="h-64 flex items-center justify-center">
        <canvas id="categoryPieChart"></canvas>
      </div>
      <div class="text-center text-[11px] text-slate-400 mt-2">
        Tháng <%= selectedMonth %> / <%= selectedYear %>
      </div>
    </div>

    <!-- Data Table (.1 Standard Format) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6 lg:col-span-2">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="font-bold text-slate-800 text-sm">Bảng Thống Kê Chi Tiết (Mẫu .1)</h3>
          <p class="text-[11px] text-slate-400">Danh sách thể loại và tỉ lệ đóng góp</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
            <tr>
              <th class="py-2.5 px-3">STT</th>
              <th class="py-2.5 px-3">Mã Thể Loại</th>
              <th class="py-2.5 px-3">Tên Thể Loại Sách</th>
              <th class="py-2.5 px-3 text-right">Số Lượt Mượn</th>
              <th class="py-2.5 px-3 text-right">Tỉ Lệ (%)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (report.categories && report.categories.length > 0) { %>
              <% report.categories.forEach((cat, idx) => { %>
                <tr class="hover:bg-slate-50 transition">
                  <td class="py-3 px-3 text-slate-400 font-mono"><%= idx + 1 %></td>
                  <td class="py-3 px-3 font-mono font-bold text-blue-700">[<%= cat.code %>]</td>
                  <td class="py-3 px-3 font-bold text-slate-800"><%= cat.category_name %></td>
                  <td class="py-3 px-3 text-right font-black text-slate-800"><%= cat.borrow_count %></td>
                  <td class="py-3 px-3 text-right">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold <%= cat.percentage > 0 ? 'bg-blue-50 text-blue-700' : 'text-slate-400' %>">
                      <%= cat.percentage %>%
                    </span>
                  </td>
                </tr>
              <% }) %>
              <!-- Total Row -->
              <tr class="bg-slate-50/80 font-bold border-t-2 border-slate-200">
                <td colspan="3" class="py-3 px-3 text-right text-slate-700 uppercase">Tổng cộng:</td>
                <td class="py-3 px-3 text-right text-blue-700 text-sm"><%= report.totalBorrows %></td>
                <td class="py-3 px-3 text-right text-blue-700 text-sm">100%</td>
              </tr>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-6 text-center text-slate-400">Chưa có số liệu mượn sách trong tháng này</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('categoryPieChart').getContext('2d');
    const categories = <%- JSON.stringify(report.categories || []) %>;

    const labels = categories.map(c => c.category_name);
    const data = categories.map(c => c.borrow_count);

    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: data.length && data.some(v => v > 0) ? data : [1],
          backgroundColor: [
            '#2563eb', '#4f46e5', '#10b981', '#f59e0b', '#ec4899', '#06b6d4', '#8b5cf6'
          ],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 12, font: { size: 10 } }
          }
        }
      }
    });
  });
</script>

<%- include('../partials/layout-end') %>
