<%- include('../partials/layout-start') %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white flex items-center justify-center text-2xl font-bold shadow-md">
        <%= user.fullname.charAt(0).toUpperCase() %>
      </div>
      <div>
        <h2 class="text-xl font-bold text-slate-800"><%= user.fullname %></h2>
        <div class="flex items-center gap-2 mt-1">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase <%= user.role === 'admin' ? 'bg-amber-100 text-amber-800' : (user.role === 'librarian' ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800') %>">
            <%= user.role === 'admin' ? 'Quản Trị Viên' : (user.role === 'librarian' ? 'Thủ Thư' : 'Độc Giả') %>
          </span>
          <span class="text-xs text-slate-400">&bull; Tham gia từ: <%= new Date(user.created_at).toLocaleDateString('vi-VN') %></span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 pt-6 border-t border-slate-100 text-sm">
      <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/60">
        <span class="text-xs text-slate-400 block mb-0.5 font-medium">Tên đăng nhập</span>
        <span class="font-semibold text-slate-800"><%= user.username %></span>
      </div>
      <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/60">
        <span class="text-xs text-slate-400 block mb-0.5 font-medium">Địa chỉ Email</span>
        <span class="font-semibold text-slate-800"><%= user.email || 'Chưa cập nhật' %></span>
      </div>
      <% if (user.linked_reader_name) { %>
        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/60 col-span-2">
          <span class="text-xs text-slate-400 block mb-0.5 font-medium">Liên kết hồ sơ độc giả</span>
          <span class="font-semibold text-slate-800"><%= user.linked_reader_name %> (<%= user.reader_code %>)</span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Change password card -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
    <h3 class="text-base font-bold text-slate-800 mb-1 flex items-center gap-2">
      <i class="fa-solid fa-key text-blue-600"></i> Đổi mật khẩu
    </h3>
    <p class="text-xs text-slate-500 mb-5">Đảm bảo mật khẩu của bạn có ít nhất 6 ký tự để bảo mật tài khoản.</p>

    <form action="/profile/password" method="POST" class="space-y-4 max-w-md">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Mật khẩu hiện tại</label>
        <input type="password" name="old_password" required
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Mật khẩu mới</label>
        <input type="password" name="new_password" required minlength="6"
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Xác nhận mật khẩu mới</label>
        <input type="password" name="confirm_password" required minlength="6"
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-xl transition shadow-sm">
        Cập nhật mật khẩu
      </button>
    </form>
  </div>
</div>

<%- include('../partials/layout-end') %>
