<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập | <%= libraryName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="h-full flex items-center justify-center p-4 sm:p-6 bg-radial from-slate-800 to-slate-950">
  <div class="max-w-md w-full">
    <!-- Brand Icon & Header -->
    <div class="text-center mb-6">
      <div class="inline-flex w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-500 items-center justify-center text-white shadow-xl mb-3">
        <i class="fa-solid fa-book-bookmark text-3xl"></i>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight"><%= libraryName %></h1>
      <p class="text-xs text-slate-400 mt-1">Đồ Án Thiết Kế Phần Mềm &bull; Hệ Thống Quản Lý Thư Viện</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-3xl p-8 shadow-2xl border border-slate-100">
      <div class="mb-6">
        <h2 class="text-xl font-bold text-slate-800">Đăng nhập</h2>
        <p class="text-xs text-slate-500 mt-0.5">Vui lòng nhập thông tin để truy cập hệ thống</p>
      </div>

      <!-- Flash messages -->
      <% if (flashError && flashError.length > 0) { %>
        <div class="mb-5 p-3.5 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-base"></i>
          <span><%= flashError[0] %></span>
        </div>
      <% } %>

      <% if (flashSuccess && flashSuccess.length > 0) { %>
        <div class="mb-5 p-3.5 bg-green-50 border border-green-200 text-green-700 text-xs rounded-xl flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-base"></i>
          <span><%= flashSuccess[0] %></span>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wider">Tên đăng nhập</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <i class="fa-solid fa-user"></i>
            </span>
            <input type="text" id="usernameInput" name="username" required
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
              placeholder="VD: admin, thuthu01, docgia01" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wider">Mật khẩu</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <i class="fa-solid fa-lock"></i>
            </span>
            <input type="password" id="passwordInput" name="password" required
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
              placeholder="••••••••" />
          </div>
        </div>

        <button type="submit"
          class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl text-sm shadow-md shadow-blue-500/20 transition-all duration-200 flex items-center justify-center gap-2 mt-2">
          <span>Đăng nhập hệ thống</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      </form>

      <!-- Quick Test Accounts Section for Examiner -->
      <div class="mt-6 pt-5 border-t border-slate-100">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2 text-center">
          Tài khoản mẫu để chấm đồ án (Click để điền nhanh)
        </div>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="quickFill('admin', 'admin123')"
            class="px-2.5 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 text-xs text-center transition font-medium">
            <div class="font-bold text-[11px]">Admin</div>
            <div class="text-[10px] text-amber-700">Toàn quyền</div>
          </button>
          <button type="button" onclick="quickFill('thuthu01', 'thuthu123')"
            class="px-2.5 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 border border-blue-200 text-blue-900 text-xs text-center transition font-medium">
            <div class="font-bold text-[11px]">Thủ Thư</div>
            <div class="text-[10px] text-blue-700">Mượn/Trả</div>
          </button>
          <button type="button" onclick="quickFill('docgia01', 'docgia123')"
            class="px-2.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-900 text-xs text-center transition font-medium">
            <div class="font-bold text-[11px]">Độc Giả</div>
            <div class="text-[10px] text-emerald-700">Tra cứu</div>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function quickFill(u, p) {
      document.getElementById('usernameInput').value = u;
      document.getElementById('passwordInput').value = p;
    }
  </script>
</body>
</html>
