<% if (flashSuccess && flashSuccess.length > 0) { %>
  <div class="mb-5 flex items-center p-4 text-green-800 bg-green-50 border border-green-200 rounded-xl shadow-sm transition-all duration-300">
    <i class="fa-solid fa-circle-check text-green-600 text-xl mr-3"></i>
    <div class="text-sm font-medium"><%= flashSuccess[0] %></div>
    <button type="button" onclick="this.parentElement.remove()" class="ml-auto text-green-600 hover:text-green-800 p-1">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
<% } %>

<% if (flashError && flashError.length > 0) { %>
  <div class="mb-5 flex items-center p-4 text-red-800 bg-red-50 border border-red-200 rounded-xl shadow-sm transition-all duration-300">
    <i class="fa-solid fa-circle-exclamation text-red-600 text-xl mr-3"></i>
    <div class="text-sm font-medium"><%= flashError[0] %></div>
    <button type="button" onclick="this.parentElement.remove()" class="ml-auto text-red-600 hover:text-red-800 p-1">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
<% } %>
