<%- include('../partials/layout-start') %>

<div class="max-w-2xl mx-auto space-y-6">
  <!-- Guidance Card for  -->
  <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-start gap-3">
    <i class="fa-solid fa-circle-info text-emerald-600 text-lg mt-0.5"></i>
    <div class="text-xs text-emerald-900 leading-relaxed">
      <span class="font-bold">Quy định 5 - Thu tiền phạt:</span>
      Số tiền thu <strong class="text-emerald-700 font-bold">không được vượt quá số tiền độc giả đang nợ</strong>. 
      Hệ thống sẽ cập nhật lại tổng nợ của độc giả ngay sau khi lập phiếu thu.
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
    <div class="mb-6 pb-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Lập Phiếu Thu Tiền Phạt</h2>
        <p class="text-xs text-slate-500">Mã phiếu thu được sinh tự động (PTxxxx)</p>
      </div>
      <a href="/fines" class="text-xs text-slate-500 hover:text-slate-800">
        <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
      </a>
    </div>

    <form action="/fines" method="POST" class="space-y-4" id="fineForm">
      <!-- Select Debtor Reader -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Chọn Độc Giả Nộp Phạt (Chỉ hiện độc giả có nợ) <span class="text-red-500">*</span>
        </label>
        <select name="reader_id" id="readerSelect" required onchange="handleReaderSelect(this)"
          class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
          <option value="">-- Chọn độc giả có nợ phạt --</option>
          <% debtors.forEach(d => { %>
            <option value="<%= d.id %>" data-debt="<%= d.total_debt %>" <%= selectedReader && selectedReader.id === d.id ? 'selected' : '' %>>
              <%= d.reader_code %> - <%= d.fullname %> &bull; Đang nợ: <%= d.total_debt.toLocaleString('vi-VN') %> đ
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Debt Snapshot Banner -->
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 grid grid-cols-2 gap-4 text-xs">
        <div>
          <span class="text-slate-400 block mb-0.5">Tổng Tiền Nợ Phạt Hiện Tại</span>
          <span id="currentDebtDisplay" class="text-lg font-black text-red-600">
            <%= selectedReader ? selectedReader.total_debt.toLocaleString('vi-VN') + ' đ' : '0 đ' %>
          </span>
        </div>
        <div>
          <span class="text-slate-400 block mb-0.5">Còn Lại Sau Khi Thu</span>
          <span id="remainingDebtDisplay" class="text-lg font-black text-slate-700">0 đ</span>
        </div>
      </div>

      <!-- Collected Amount -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Số Tiền Thu (VNĐ) <span class="text-red-500">*</span>
          <span class="text-[10px] text-emerald-600 font-normal">(≤ Tổng nợ theo quy định)</span>
        </label>
        <div class="relative">
          <input type="number" id="collectedAmountInput" name="collected_amount" required min="0" step="1"
            value="<%= selectedReader ? selectedReader.total_debt : '' %>"
            placeholder="Nhập số tiền nộp..."
            class="w-full pl-3.5 pr-20 py-2.5 border border-slate-200 rounded-xl text-sm font-bold text-slate-800 focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
          <button type="button" onclick="payAll()"
            class="absolute right-2 top-2 px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium">
            Nộp tất cả
          </button>
        </div>
        <span id="fineError" class="text-[11px] text-red-600 font-semibold mt-1 hidden block"></span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Ghi Chú Nộp Phạt</label>
        <input type="text" name="note" placeholder="Nộp phạt trễ hạn mượn sách..."
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <div class="pt-3 flex items-center justify-end gap-3">
        <a href="/fines" class="px-4 py-2.5 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-xl text-xs font-semibold transition">
          Hủy bỏ
        </a>
        <button type="submit" id="submitFineBtn"
          class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-2">
          <i class="fa-solid fa-receipt"></i>
          <span>Xác Nhận Thu Tiền</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  let currentDebt = <%= selectedReader ? selectedReader.total_debt : 0 %>;
  const readerSelect = document.getElementById('readerSelect');
  const collectedInput = document.getElementById('collectedAmountInput');
  const debtDisplay = document.getElementById('currentDebtDisplay');
  const remainingDisplay = document.getElementById('remainingDebtDisplay');
  const fineError = document.getElementById('fineError');
  const submitBtn = document.getElementById('submitFineBtn');

  function handleReaderSelect(sel) {
    const opt = sel.options[sel.selectedIndex];
    currentDebt = Number(opt.getAttribute('data-debt')) || 0;
    debtDisplay.textContent = currentDebt.toLocaleString('vi-VN') + ' đ';
    collectedInput.value = currentDebt;
    validateAmount();
  }

  function payAll() {
    collectedInput.value = currentDebt;
    validateAmount();
  }

  function validateAmount() {
    const amount = Number(collectedInput.value) || 0;
    const remaining = currentDebt - amount;

    if (amount <= 0) {
      remainingDisplay.textContent = currentDebt.toLocaleString('vi-VN') + ' đ';
      fineError.classList.add('hidden');
      submitBtn.disabled = false;
      return;
    }

    if (amount > currentDebt) {
      fineError.textContent = `❌ Thông báo: Số tiền thu (${amount.toLocaleString('vi-VN')} đ) không được lớn hơn tổng tiền nợ (${currentDebt.toLocaleString('vi-VN')} đ)!`;
      fineError.classList.remove('hidden');
      remainingDisplay.textContent = 'Không hợp lệ';
      remainingDisplay.className = 'text-lg font-black text-red-600';
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50');
    } else {
      fineError.classList.add('hidden');
      remainingDisplay.textContent = Math.max(0, remaining).toLocaleString('vi-VN') + ' đ';
      remainingDisplay.className = 'text-lg font-black text-slate-700';
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50');
    }
  }

  collectedInput.addEventListener('input', validateAmount);
  validateAmount();
</script>

<%- include('../partials/layout-end') %>
