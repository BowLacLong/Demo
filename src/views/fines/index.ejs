<%- include('../partials/layout-start') %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Quản Lý Thu Tiền Phạt (QĐ5)</h2>
      <p class="text-xs text-slate-500">Lập phiếu thu tiền phạt quá hạn / hư hỏng sách cho độc giả theo đúng quy định</p>
    </div>

    <div class="flex items-center gap-2.5">
      <a href="/fines/export" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
        <i class="fa-solid fa-file-excel"></i>
        <span>Xuất Excel</span>
      </a>
      <a href="/fines/create" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
        <i class="fa-solid fa-plus-circle"></i>
        <span>Lập Phiếu Thu Tiền (QĐ5)</span>
      </a>
    </div>
  </div>

  <!-- Search Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
    <form action="/fines" method="GET" class="flex gap-3">
      <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
        </span>
        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Tìm theo mã phiếu PT..., tên độc giả, mã DG..."
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500" />
      </div>

      <button type="submit" class="px-5 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-semibold transition">
        <i class="fa-solid fa-filter mr-1"></i> Tìm kiếm
      </button>
      <% if (filters.search) { %>
        <a href="/fines" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs transition">
          Xóa
        </a>
      <% } %>
    </form>
  </div>

  <!-- Fine Receipts Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Mã Phiếu Thu</th>
            <th class="py-3 px-4">Độc Giả</th>
            <th class="py-3 px-4">Ngày Thu</th>
            <th class="py-3 px-4">Tổng Nợ Trước Thu</th>
            <th class="py-3 px-4">Số Tiền Thu</th>
            <th class="py-3 px-4">Còn Lại</th>
            <th class="py-3 px-4">Người Thu</th>
            <th class="py-3 px-4 text-right">In Biên Lai</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (receipts && receipts.length > 0) { %>
            <% receipts.forEach(r => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-600">
                  <a href="/fines/<%= r.id %>" class="hover:underline flex items-center gap-1.5">
                    <i class="fa-solid fa-receipt text-slate-400"></i>
                    <span><%= r.receipt_code %></span>
                  </a>
                </td>
                <td class="py-3.5 px-4">
                  <a href="/readers/<%= r.reader_id %>" class="font-bold text-slate-800 hover:text-blue-600 block">
                    <%= r.reader_name %>
                  </a>
                  <span class="text-[11px] text-slate-400 font-mono"><%= r.reader_code %></span>
                </td>
                <td class="py-3.5 px-4 text-slate-600">
                  <%= new Date(r.receipt_date).toLocaleDateString('vi-VN') %>
                </td>
                <td class="py-3.5 px-4 text-slate-500 font-medium">
                  <%= r.total_debt.toLocaleString('vi-VN') %> đ
                </td>
                <td class="py-3.5 px-4 font-black text-emerald-600">
                  <%= r.collected_amount.toLocaleString('vi-VN') %> đ
                </td>
                <td class="py-3.5 px-4 font-semibold text-slate-700">
                  <%= r.remaining_debt.toLocaleString('vi-VN') %> đ
                </td>
                <td class="py-3.5 px-4 text-slate-600"><%= r.creator_name || 'Admin' %></td>
                <td class="py-3.5 px-4 text-right">
                  <a href="/fines/<%= r.id %>/print" target="_blank" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition inline-flex items-center gap-1">
                    <i class="fa-solid fa-print"></i> In phiếu
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-8 text-slate-400">Chưa có phiếu thu tiền phạt nào</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
