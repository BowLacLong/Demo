<%- include('../partials/layout-start') %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <a href="/fines" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-800 transition">
      <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách phiếu thu
    </a>

    <a href="/fines/<%= receipt.id %>/print" target="_blank"
      class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-2">
      <i class="fa-solid fa-print"></i>
      <span>In Phiếu Thu</span>
    </a>
  </div>

  <!-- Receipt Box -->
  <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-xs space-y-6">
    <div class="flex items-center justify-between border-b border-slate-100 pb-5">
      <div>
        <h3 class="font-extrabold text-xl text-slate-800">Phiếu Thu Tiền Phạt: <%= receipt.receipt_code %></h3>
        <p class="text-xs text-slate-400 mt-0.5">Ngày lập: <%= new Date(receipt.receipt_date).toLocaleString('vi-VN') %></p>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
        <i class="fa-solid fa-receipt"></i>
      </div>
    </div>

    <!-- Reader Info -->
    <div class="grid grid-cols-2 gap-4 text-xs bg-slate-50 p-4 rounded-2xl border border-slate-100">
      <div>
        <span class="text-slate-400 block mb-0.5">Độc giả</span>
        <span class="font-bold text-slate-800 text-sm"><%= receipt.reader_name %></span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">Mã thẻ độc giả</span>
        <span class="font-mono font-bold text-blue-600"><%= receipt.reader_code %></span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">Địa chỉ</span>
        <span class="font-medium text-slate-700"><%= receipt.reader_address %></span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">Người lập phiếu</span>
        <span class="font-medium text-slate-700"><%= receipt.creator_name || 'Admin' %></span>
      </div>
    </div>

    <!-- Financial Details Table -->
    <div class="border border-slate-200 rounded-2xl overflow-hidden text-xs">
      <div class="flex items-center justify-between p-3.5 bg-slate-50 border-b border-slate-200 text-slate-600">
        <span>Tổng số tiền độc giả đang nợ trước khi thu:</span>
        <span class="font-bold text-slate-800"><%= receipt.total_debt.toLocaleString('vi-VN') %> VNĐ</span>
      </div>
      <div class="flex items-center justify-between p-4 bg-emerald-50/50 border-b border-slate-200">
        <span class="font-bold text-emerald-900 text-sm">Số tiền thực tế thu (QĐ5):</span>
        <span class="font-black text-emerald-600 text-lg"><%= receipt.collected_amount.toLocaleString('vi-VN') %> VNĐ</span>
      </div>
      <div class="flex items-center justify-between p-3.5 bg-slate-50 text-slate-600">
        <span>Số tiền nợ còn lại sau khi thanh toán:</span>
        <span class="font-bold text-slate-800"><%= receipt.remaining_debt.toLocaleString('vi-VN') %> VNĐ</span>
      </div>
    </div>

    <% if (receipt.note) { %>
      <div class="text-xs text-slate-500 bg-slate-50 p-3 rounded-xl border border-slate-100">
        <span class="font-semibold text-slate-700">Lý do thu / Ghi chú:</span> <%= receipt.note %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/layout-end') %>
