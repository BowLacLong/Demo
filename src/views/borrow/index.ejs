<%- include('../partials/layout-start') %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Quản Lý Mượn - Trả Sách (QĐ3, QĐ4)</h2>
      <p class="text-xs text-slate-500">Lập phiếu mượn, theo dõi hạn trả, gia hạn thời gian và nhận trả sách kèm tính phạt</p>
    </div>

    <div class="flex items-center gap-2.5">
      <a href="/borrow/export" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
        <i class="fa-solid fa-file-excel"></i>
        <span>Xuất Excel</span>
      </a>
      <a href="/borrow/create" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
        <i class="fa-solid fa-plus-circle"></i>
        <span>Lập Phiếu Mượn (QĐ3)</span>
      </a>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
    <form action="/borrow" method="GET" class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <div class="relative sm:col-span-2">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
        </span>
        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Tìm theo mã phiếu PM..., tên độc giả, mã DG..."
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500" />
      </div>

      <div>
        <select name="status" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
          <option value="">-- Tất cả trạng thái --</option>
          <option value="borrowing" <%= filters.status === 'borrowing' ? 'selected' : '' %>>Đang mượn</option>
          <option value="overdue" <%= filters.status === 'overdue' ? 'selected' : '' %>>Quá hạn</option>
          <option value="returned" <%= filters.status === 'returned' ? 'selected' : '' %>>Đã hoàn tất trả</option>
        </select>
      </div>

      <div class="flex items-center gap-2 justify-end">
        <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-semibold transition">
          <i class="fa-solid fa-filter mr-1"></i> Lọc
        </button>
        <% if (filters.search || filters.status) { %>
          <a href="/borrow" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs transition">
            Xóa lọc
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Tickets Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Mã Phiếu</th>
            <th class="py-3 px-4">Độc Giả</th>
            <th class="py-3 px-4">Ngày Mượn</th>
            <th class="py-3 px-4">Hạn Trả</th>
            <th class="py-3 px-4">Số Cuốn Đang Giữ</th>
            <th class="py-3 px-4">Trạng Thái</th>
            <th class="py-3 px-4 text-right">Thao Tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (tickets && tickets.length > 0) { %>
            <% tickets.forEach(t => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 font-mono font-bold text-blue-600">
                  <a href="/borrow/<%= t.id %>" class="hover:underline flex items-center gap-1.5">
                    <i class="fa-solid fa-receipt text-slate-400"></i>
                    <span><%= t.ticket_code %></span>
                  </a>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-bold text-slate-800"><%= t.reader_name %></div>
                  <div class="text-[11px] text-slate-400"><%= t.reader_code %> &bull; <%= t.reader_phone || 'N/A' %></div>
                </td>
                <td class="py-3.5 px-4 text-slate-600"><%= t.borrow_date %></td>
                <td class="py-3.5 px-4 font-medium <%= t.is_overdue ? 'text-red-600 font-bold' : 'text-slate-700' %>">
                  <%= t.due_date %>
                  <% if (t.is_overdue) { %>
                    <span class="block text-[10px] text-red-600 font-bold animate-pulse">⚠️ Quá hạn trả!</span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= t.active_items > 0 ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-green-50 text-green-700' %>">
                    <%= t.active_items %> / <%= t.total_items %> cuốn
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <% if (t.status === 'borrowing' && !t.is_overdue) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">Đang mượn</span>
                  <% } else if (t.status === 'overdue' || t.is_overdue) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800">Quá hạn</span>
                  <% } else if (t.status === 'partially_returned') { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Trả 1 phần</span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-800">Đã trả đủ</span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href="/borrow/<%= t.id %>" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition">
                      Chi tiết
                    </a>
                    <% if (t.active_items > 0) { %>
                      <a href="/borrow/<%= t.id %>/return" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-medium transition shadow-2xs">
                        Trả sách
                      </a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-8 text-slate-400">Không có phiếu mượn nào</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
