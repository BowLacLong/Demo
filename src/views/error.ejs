<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-100">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="h-full flex items-center justify-center p-6 font-sans">
  <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl text-center border border-slate-200">
    <div class="w-16 h-16 mx-auto mb-4 bg-red-100 text-red-600 rounded-full flex items-center justify-center text-2xl">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div class="text-4xl font-extrabold text-slate-800 mb-2"><%= statusCode || 500 %></div>
    <h1 class="text-xl font-bold text-slate-700 mb-2"><%= title %></h1>
    <p class="text-sm text-slate-500 mb-6"><%= message %></p>
    <div class="flex items-center justify-center gap-3">
      <a href="javascript:history.back()" class="px-4 py-2 border border-slate-300 rounded-xl text-slate-700 text-sm font-medium hover:bg-slate-50 transition">
        <i class="fa-solid fa-arrow-left mr-1.5"></i> Quay lại
      </a>
      <a href="/" class="px-4 py-2 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm">
        <i class="fa-solid fa-house mr-1.5"></i> Về trang chủ
      </a>
    </div>
  </div>
</body>
</html>
