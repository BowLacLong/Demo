<%- include('../partials/layout-start') %>

<%
  const reservationStatusLabel = {
    pending: 'Chờ duyệt',
    approved: 'Đã duyệt',
    fulfilled: 'Đã nhận sách',
    cancelled: 'Đã huỷ',
    expired: 'Hết hạn'
  };
  const reservationStatusClass = {
    pending: 'bg-amber-100 text-amber-800',
    approved: 'bg-blue-100 text-blue-800',
    fulfilled: 'bg-green-100 text-green-800',
    cancelled: 'bg-slate-200 text-slate-600',
    expired: 'bg-red-100 text-red-800'
  };
  const ticketStatusLabel = {
    borrowing: 'Đang mượn',
    overdue: 'Quá hạn',
    partially_returned: 'Trả 1 phần',
    returned: 'Đã trả đủ'
  };
  const readerStatusLabel = { active: 'Đang hoạt động', suspended: 'Tạm ngưng', expired: 'Hết hạn' };
  const pendingReservations = reservations.filter(r => r.status === 'pending' || r.status === 'approved');
%>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Cổng Thông Tin Độc Giả</h2>
      <p class="text-xs text-slate-500">Thẻ thư viện, sách đang mượn, yêu cầu đặt trước và lịch sử mượn trả của bạn</p>
    </div>
    <a href="/books" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5 self-start">
      <i class="fa-solid fa-magnifying-glass"></i>
      <span>Tra cứu danh mục sách</span>
    </a>
  </div>

  <!-- Thẻ độc giả + thống kê -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-xs p-5">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white flex items-center justify-center text-xl font-black shadow-md">
          <%= reader.fullname.charAt(0).toUpperCase() %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-lg font-bold text-slate-800 truncate"><%= reader.fullname %></h3>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= reader.status === 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800' %>">
              <%= readerStatusLabel[reader.status] || reader.status %>
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">
            Mã thẻ: <span class="font-mono font-bold text-blue-600"><%= reader.reader_code %></span>
            &bull; <%= reader.type_name %>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 text-xs">
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
          <span class="text-slate-400 block mb-0.5">Ngày cấp thẻ</span>
          <span class="font-bold text-slate-800"><%= reader.created_date %></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
          <span class="text-slate-400 block mb-0.5">Hạn sử dụng thẻ</span>
          <span class="font-bold text-slate-800"><%= reader.expiry_date %></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
          <span class="text-slate-400 block mb-0.5">Email</span>
          <span class="font-bold text-slate-800 break-all"><%= reader.email %></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
          <span class="text-slate-400 block mb-0.5">Điện thoại</span>
          <span class="font-bold text-slate-800"><%= reader.phone || 'Chưa cập nhật' %></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 sm:col-span-2">
          <span class="text-slate-400 block mb-0.5">Địa chỉ</span>
          <span class="font-bold text-slate-800"><%= reader.address %></span>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-4">
        <div class="flex items-center justify-between">
          <span class="text-xs text-slate-500 font-medium">Sách đang mượn</span>
          <i class="fa-solid fa-book-open text-blue-500"></i>
        </div>
        <div class="text-2xl font-black text-slate-800 mt-1">
          <%= activeBorrows.length %>
          <span class="text-sm font-semibold text-slate-400">/ <%= reader.max_borrow_limit %> cuốn</span>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-4">
        <div class="flex items-center justify-between">
          <span class="text-xs text-slate-500 font-medium">Nợ phạt hiện tại</span>
          <i class="fa-solid fa-money-bill-wave text-amber-500"></i>
        </div>
        <div class="text-2xl font-black <%= (reader.total_debt || 0) > 0 ? 'text-red-600' : 'text-emerald-600' %> mt-1">
          <%= (reader.total_debt || 0).toLocaleString('vi-VN') %> <span class="text-sm font-semibold text-slate-400">VNĐ</span>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-4">
        <div class="flex items-center justify-between">
          <span class="text-xs text-slate-500 font-medium">Sách quá hạn</span>
          <i class="fa-solid fa-triangle-exclamation text-red-500"></i>
        </div>
        <div class="text-2xl font-black <%= reader.overdue_books_count > 0 ? 'text-red-600' : 'text-slate-800' %> mt-1">
          <%= reader.overdue_books_count %> <span class="text-sm font-semibold text-slate-400">cuốn</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Sách đang mượn -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-slate-800">Sách Đang Mượn</h3>
        <p class="text-xs text-slate-500">Theo dõi hạn trả để tránh phát sinh tiền phạt</p>
      </div>
      <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1 rounded-full"><%= activeBorrows.length %> cuốn</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Mã Phiếu</th>
            <th class="py-3 px-4">Tên Sách</th>
            <th class="py-3 px-4">Mã Vạch</th>
            <th class="py-3 px-4">Ngày Mượn</th>
            <th class="py-3 px-4">Hạn Trả</th>
            <th class="py-3 px-4">Tình Trạng</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (activeBorrows.length > 0) { %>
            <% activeBorrows.forEach(b => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 font-mono font-bold text-blue-600"><%= b.ticket_code %></td>
                <td class="py-3.5 px-4 font-semibold text-slate-800">
                  <a href="/books/<%= b.book_id %>" class="hover:text-blue-600 hover:underline"><%= b.book_title %></a>
                </td>
                <td class="py-3.5 px-4 font-mono text-slate-600"><%= b.barcode %></td>
                <td class="py-3.5 px-4 text-slate-600"><%= b.borrow_date %></td>
                <td class="py-3.5 px-4 font-medium text-slate-700"><%= b.due_date %></td>
                <td class="py-3.5 px-4">
                  <% if (b.is_overdue) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800">
                      Trễ <%= Math.abs(b.days_left) %> ngày
                    </span>
                  <% } else if (b.days_left <= 3) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                      Còn <%= b.days_left %> ngày
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                      Còn <%= b.days_left %> ngày
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-8 text-slate-400">Bạn hiện không mượn cuốn sách nào</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Yêu cầu đặt mượn -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-slate-800">Yêu Cầu Đặt Mượn Của Tôi</h3>
        <p class="text-xs text-slate-500">Đặt trước sách từ trang chi tiết sách; thủ thư sẽ duyệt yêu cầu của bạn</p>
      </div>
      <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
        <%= pendingReservations.length %> đang xử lý
      </span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Sách</th>
            <th class="py-3 px-4">Ngày Đặt</th>
            <th class="py-3 px-4">Ghi Chú</th>
            <th class="py-3 px-4">Trạng Thái</th>
            <th class="py-3 px-4 text-right">Thao Tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (reservations.length > 0) { %>
            <% reservations.forEach(r => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4">
                  <a href="/books/<%= r.book_id %>" class="font-semibold text-slate-800 hover:text-blue-600 hover:underline flex items-center gap-2">
                    <img src="<%= r.cover_image || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=80' %>"
                      alt="" class="w-7 h-9 object-cover rounded-md border border-slate-100" />
                    <span><%= r.book_title %></span>
                  </a>
                  <div class="text-[11px] text-slate-400 mt-0.5"><%= r.category_name %></div>
                </td>
                <td class="py-3.5 px-4 text-slate-600 font-mono"><%= (r.reserve_date || '').toString().slice(0, 16) %></td>
                <td class="py-3.5 px-4 text-slate-500 max-w-[200px]"><%= r.note || '—' %></td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= reservationStatusClass[r.status] || 'bg-slate-100 text-slate-700' %>">
                    <%= reservationStatusLabel[r.status] || r.status %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <% if (r.status === 'pending' || r.status === 'approved') { %>
                    <form action="/portal/reservations/<%= r.id %>/cancel" method="POST" onsubmit="return confirm('Huỷ yêu cầu đặt mượn này?');">
                      <button type="submit" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition">
                        Huỷ yêu cầu
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-slate-300">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-8 text-slate-400">Bạn chưa có yêu cầu đặt mượn nào</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Lịch sử mượn trả -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-800">Lịch Sử Mượn Trả</h3>
      <p class="text-xs text-slate-500">Toàn bộ phiếu mượn và tình trạng trả sách của bạn</p>
    </div>
    <div class="divide-y divide-slate-100">
      <% if (tickets.length > 0) { %>
        <% tickets.forEach(t => { %>
          <div class="px-5 py-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-3">
                <span class="font-mono font-bold text-blue-600 text-sm"><%= t.ticket_code %></span>
                <span class="text-[11px] text-slate-400">
                  Mượn <%= t.borrow_date %> &bull; Hạn trả <%= t.due_date %>
                </span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= t.status === 'returned' ? 'bg-green-100 text-green-800' : (t.status === 'overdue' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800') %>">
                <%= ticketStatusLabel[t.status] || t.status %>
              </span>
            </div>
            <ul class="mt-2 space-y-1 text-xs text-slate-600">
              <% t.details.forEach(d => { %>
                <li class="flex flex-wrap items-center gap-2">
                  <i class="fa-solid fa-book text-slate-300"></i>
                  <a href="/books/<%= d.book_id %>" class="font-medium text-slate-700 hover:text-blue-600 hover:underline"><%= d.book_title %></a>
                  <span class="font-mono text-[11px] text-slate-400"><%= d.barcode %></span>
                  <span class="text-[11px] <%= d.status === 'returned' ? 'text-emerald-600' : 'text-slate-400' %>">
                    <%= d.return_date ? 'Đã trả ngày ' + d.return_date : 'Chưa trả' %>
                  </span>
                  <% if (d.fine_amount > 0) { %>
                    <span class="text-[11px] font-bold text-red-600">Phạt <%= d.fine_amount.toLocaleString('vi-VN') %>đ</span>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-8 text-slate-400 text-xs">Chưa có lịch sử mượn sách</div>
      <% } %>
    </div>
  </div>

  <!-- Phiếu thu tiền phạt -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-800">Các Khoản Phạt Đã Thanh Toán</h3>
      <p class="text-xs text-slate-500">Biên lai thu tiền phạt do thủ thư lập cho bạn</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Mã Biên Lai</th>
            <th class="py-3 px-4">Ngày Thu</th>
            <th class="py-3 px-4">Tổng Nợ</th>
            <th class="py-3 px-4">Đã Thu</th>
            <th class="py-3 px-4">Còn Nợ</th>
            <th class="py-3 px-4">Ghi Chú</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (receipts.length > 0) { %>
            <% receipts.forEach(r => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 font-mono font-bold text-blue-600"><%= r.receipt_code %></td>
                <td class="py-3.5 px-4 text-slate-600"><%= (r.receipt_date || '').toString().slice(0, 10) %></td>
                <td class="py-3.5 px-4 text-slate-600"><%= (r.total_debt || 0).toLocaleString('vi-VN') %>đ</td>
                <td class="py-3.5 px-4 font-bold text-emerald-600"><%= (r.collected_amount || 0).toLocaleString('vi-VN') %>đ</td>
                <td class="py-3.5 px-4 font-bold <%= (r.remaining_debt || 0) > 0 ? 'text-red-600' : 'text-slate-400' %>">
                  <%= (r.remaining_debt || 0).toLocaleString('vi-VN') %>đ
                </td>
                <td class="py-3.5 px-4 text-slate-500"><%= r.note || '—' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-8 text-slate-400">Bạn chưa có khoản phạt nào</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
