<%- include('../partials/layout-start') %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
    <div class="mb-6 pb-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Chỉnh Sửa Thẻ Độc Giả</h2>
        <p class="text-xs text-slate-500">Mã thẻ: <%= reader.reader_code %></p>
      </div>
      <a href="/readers/<%= reader.id %>" class="text-xs text-slate-500 hover:text-slate-800">
        <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
      </a>
    </div>

    <form action="/readers/<%= reader.id %>" method="POST" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Họ và Tên Độc Giả <span class="text-red-500">*</span></label>
          <input type="text" name="fullname" value="<%= reader.fullname %>" required
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Loại Độc Giả (QĐ2) <span class="text-red-500">*</span></label>
          <select name="reader_type_id" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <% readerTypes.forEach(rt => { %>
              <option value="<%= rt.id %>" <%= reader.reader_type_id == rt.id ? 'selected' : '' %>>
                [<%= rt.code %>] <%= rt.name %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Ngày Sinh (QĐ2) <span class="text-red-500">*</span></label>
          <input type="date" name="date_of_birth" value="<%= reader.date_of_birth %>" required
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Số Điện Thoại</label>
          <input type="tel" name="phone" value="<%= reader.phone || '' %>"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Địa Chỉ Email <span class="text-red-500">*</span></label>
          <input type="email" name="email" value="<%= reader.email %>" required
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Trạng Thái Thẻ</label>
          <select name="status" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <option value="active" <%= reader.status === 'active' ? 'selected' : '' %>>Hoạt động bình thường</option>
            <option value="suspended" <%= reader.status === 'suspended' ? 'selected' : '' %>>Tạm ngưng / Bị khóa</option>
            <option value="expired" <%= reader.status === 'expired' ? 'selected' : '' %>>Hết hạn</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Địa Chỉ Thường Trú <span class="text-red-500">*</span></label>
        <input type="text" name="address" value="<%= reader.address %>" required
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <div class="pt-3 flex items-center justify-end gap-3">
        <a href="/readers/<%= reader.id %>" class="px-4 py-2.5 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-xl text-xs font-semibold transition">
          Hủy bỏ
        </a>
        <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition">
          <i class="fa-solid fa-floppy-disk mr-1.5"></i> Lưu Thay Đổi
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/layout-end') %>
