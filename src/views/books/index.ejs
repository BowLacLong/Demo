<%- include('../partials/layout-start') %>

<div class="space-y-6">
  <!-- Top Bar: Title & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Kho Sách & Tra Cứu (OPAC)</h2>
      <p class="text-xs text-slate-500">Tra cứu tài liệu thư viện, quản lý đầu sách và bản sách cá biệt</p>
    </div>

    <div class="flex items-center gap-2.5">
      <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'librarian')) { %>
        <a href="/books/export" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
          <i class="fa-solid fa-file-excel"></i>
          <span>Xuất Excel</span>
        </a>
        <a href="/books/create" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition flex items-center gap-1.5">
          <i class="fa-solid fa-plus"></i>
          <span>Tiếp Nhận Sách Mới (QĐ1)</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
    <form action="/books" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <!-- Search Keyword -->
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
        </span>
        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Tìm theo tên sách, ISBN, tác giả..."
          class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500" />
      </div>

      <!-- Category Filter -->
      <div>
        <select name="category_id" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
          <option value="">-- Tất cả thể loại --</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= filters.category_id == c.id ? 'selected' : '' %>>
              [<%= c.code %>] <%= c.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Available Only Filter -->
      <div class="flex items-center">
        <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
          <input type="checkbox" name="available_only" value="true" <%= filters.available_only === 'true' ? 'checked' : '' %>
            class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
          <span>Chỉ hiện sách còn sẵn trong kho</span>
        </label>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2 justify-end">
        <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-semibold transition">
          <i class="fa-solid fa-filter mr-1"></i> Lọc kết quả
        </button>
        <% if (filters.search || filters.category_id || filters.available_only) { %>
          <a href="/books" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs transition">
            Xóa lọc
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Book Grid Display -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <% if (books && books.length > 0) { %>
      <% books.forEach(book => { %>
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col group">
          <!-- Cover Image Container -->
          <div class="h-48 overflow-hidden bg-slate-100 relative">
            <img src="<%= book.cover_image || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=400' %>" 
                 alt="<%= book.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-bold shadow-xs <%= book.available_copies > 0 ? 'bg-emerald-600 text-white' : 'bg-red-600 text-white' %>">
              <%= book.available_copies > 0 ? `Còn ${book.available_copies}/${book.total_copies}` : 'Đã mượn hết' %>
            </span>
            <span class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-900/70 backdrop-blur-xs text-white">
              <%= book.category_code %>: <%= book.category_name %>
            </span>
          </div>

          <!-- Content -->
          <div class="p-4 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-[11px] text-slate-400 font-medium mb-1">
                Năm XB: <%= book.publish_year %> &bull; <%= book.author_name || 'Nhiều tác giả' %>
              </div>
              <h3 class="font-bold text-slate-800 text-sm line-clamp-2 hover:text-blue-600 transition">
                <a href="/books/<%= book.id %>"><%= book.title %></a>
              </h3>
              <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">
                <%= book.summary || 'Chưa có tóm tắt nội dung tài liệu.' %>
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-bold text-blue-600">
                <%= (book.price || 0).toLocaleString('vi-VN') %> đ
              </span>
              <a href="/books/<%= book.id %>" class="px-2.5 py-1 bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 rounded-lg text-xs font-medium transition">
                Chi tiết &rarr;
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full py-12 text-center bg-white rounded-2xl border border-slate-200">
        <i class="fa-solid fa-book-open text-4xl text-slate-300 mb-3 block"></i>
        <p class="text-sm font-semibold text-slate-700">Không tìm thấy sách nào phù hợp</p>
        <p class="text-xs text-slate-400 mt-1">Thử thay đổi từ khóa hoặc bộ lọc tìm kiếm.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/layout-end') %>
