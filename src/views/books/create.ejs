<%- include('../partials/layout-start') %>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Guidance Card for QĐ1 -->
  <div class="p-4 bg-blue-50 border border-blue-200 rounded-2xl flex items-start gap-3">
    <i class="fa-solid fa-circle-info text-blue-600 text-lg mt-0.5"></i>
    <div class="text-xs text-blue-900 leading-relaxed">
      <span class="font-bold">Quy định 1 (QĐ1) - Tiếp nhận sách:</span>
      Chỉ tiếp nhận các sách xuất bản trong vòng <strong class="text-blue-700 font-bold"><%= maxGap %> năm</strong> gần nhất 
      (từ năm <strong><%= minPublishYear %></strong> đến năm <strong><%= currentYear %></strong>). 
      Các thể loại phải thuộc danh mục được phép theo quy định.
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
    <div class="mb-6 pb-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Tiếp Nhận Sách Mới</h2>
        <p class="text-xs text-slate-500">Nhập thông tin tựa sách và khởi tạo các bản sách cá biệt ban đầu</p>
      </div>
      <a href="/books" class="text-xs text-slate-500 hover:text-slate-800">
        <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
      </a>
    </div>

    <form action="/books" method="POST" class="space-y-4" id="createBookForm">
      <!-- Title -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tên Sách <span class="text-red-500">*</span></label>
        <input type="text" name="title" required placeholder="Nhập tên đầu sách"
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Category -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Thể Loại (QĐ1) <span class="text-red-500">*</span></label>
          <select name="category_id" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <option value="">-- Chọn thể loại --</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>">[<%= c.code %>] <%= c.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Author -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tác Giả</label>
          <select name="author_id" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <option value="">-- Chọn tác giả --</option>
            <% authors.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Publisher -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nhà Xuất Bản</label>
          <select name="publisher_id" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <option value="">-- Chọn NXB --</option>
            <% publishers.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Publish Year (QĐ1) -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Năm Xuất Bản <span class="text-red-500">*</span>
            <span class="text-[10px] text-blue-600 font-normal">(≥ <%= minPublishYear %>)</span>
          </label>
          <input type="number" id="publishYearInput" name="publish_year" required min="<%= minPublishYear %>" max="<%= currentYear %>" value="<%= currentYear %>"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
          <span id="yearError" class="text-[11px] text-red-500 hidden mt-1 block"></span>
        </div>

        <!-- Price -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Trị Giá (VNĐ) <span class="text-red-500">*</span></label>
          <input type="number" name="price" required min="1000" step="1000" value="100000"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- ISBN -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Mã ISBN (Tùy chọn)</label>
          <input type="text" name="isbn" placeholder="VD: 978-604-80-5511-1"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>

        <!-- Cover Image URL -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">URL Ảnh Bìa (Tùy chọn)</label>
          <input type="url" name="cover_image" placeholder="https://..."
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
      </div>

      <!-- Copies initialization -->
      <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Số lượng bản sách nhập ban đầu</label>
          <input type="number" name="initial_copies" min="1" max="50" value="3"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Vị trí kệ xếp sách</label>
          <input type="text" name="location" value="Kệ 1 - Ngăn 1"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
      </div>

      <!-- Summary -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tóm tắt nội dung tài liệu</label>
        <textarea name="summary" rows="3" placeholder="Mô tả sơ lược nội dung sách..."
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden"></textarea>
      </div>

      <div class="pt-3 flex items-center justify-end gap-3">
        <a href="/books" class="px-4 py-2.5 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-xl text-xs font-semibold transition">
          Hủy bỏ
        </a>
        <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition">
          <i class="fa-solid fa-plus-circle mr-1.5"></i> Tiếp Nhận Sách
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Live QĐ1 year validation
  const minYear = <%= minPublishYear %>;
  const currentYear = <%= currentYear %>;
  const yearInput = document.getElementById('publishYearInput');
  const errorMsg = document.getElementById('yearError');

  yearInput.addEventListener('input', function() {
    const val = Number(this.value);
    if (val < minYear) {
      errorMsg.textContent = `Vi phạm QĐ1: Sách xuất bản trước năm ${minYear} (quá ${currentYear - minYear} năm) không được tiếp nhận!`;
      errorMsg.classList.remove('hidden');
    } else if (val > currentYear) {
      errorMsg.textContent = `Năm xuất bản không được lớn hơn năm hiện tại (${currentYear})!`;
      errorMsg.classList.remove('hidden');
    } else {
      errorMsg.classList.add('hidden');
    }
  });
</script>

<%- include('../partials/layout-end') %>
