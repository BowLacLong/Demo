<%- include('../partials/layout-start') %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
    <div class="mb-6 pb-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-bold text-slate-800">Chỉnh Sửa Thông Tin Sách</h2>
        <p class="text-xs text-slate-500">Mã sách: B<%= String(book.id).padStart(4, '0') %></p>
      </div>
      <a href="/books/<%= book.id %>" class="text-xs text-slate-500 hover:text-slate-800">
        <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
      </a>
    </div>

    <form action="/books/<%= book.id %>" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tên Sách <span class="text-red-500">*</span></label>
        <input type="text" name="title" value="<%= book.title %>" required
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Thể Loại <span class="text-red-500">*</span></label>
          <select name="category_id" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>" <%= book.category_id == c.id ? 'selected' : '' %>>
                [<%= c.code %>] <%= c.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tác Giả</label>
          <select name="author_id" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <option value="">-- Chọn tác giả --</option>
            <% authors.forEach(a => { %>
              <option value="<%= a.id %>" <%= book.author_id == a.id ? 'selected' : '' %>><%= a.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nhà Xuất Bản</label>
          <select name="publisher_id" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden">
            <option value="">-- Chọn NXB --</option>
            <% publishers.forEach(p => { %>
              <option value="<%= p.id %>" <%= book.publisher_id == p.id ? 'selected' : '' %>><%= p.name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Năm Xuất Bản <span class="text-red-500">*</span>
          </label>
          <input type="number" name="publish_year" value="<%= book.publish_year %>" required min="<%= minPublishYear %>" max="<%= currentYear %>"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Trị Giá (VNĐ) <span class="text-red-500">*</span></label>
          <input type="number" name="price" value="<%= book.price %>" required min="1000" step="1000"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Mã ISBN</label>
          <input type="text" name="isbn" value="<%= book.isbn || '' %>"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">URL Ảnh Bìa</label>
          <input type="url" name="cover_image" value="<%= book.cover_image || '' %>"
            class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tóm tắt nội dung</label>
        <textarea name="summary" rows="3"
          class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 focus:outline-hidden"><%= book.summary || '' %></textarea>
      </div>

      <div class="pt-3 flex items-center justify-end gap-3">
        <a href="/books/<%= book.id %>" class="px-4 py-2.5 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-xl text-xs font-semibold transition">
          Hủy bỏ
        </a>
        <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold shadow-xs transition">
          <i class="fa-solid fa-floppy-disk mr-1.5"></i> Lưu Thay Đổi
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/layout-end') %>
