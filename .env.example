# Sao chép tệp này thành .env rồi chỉnh giá trị cho phù hợp.
# Tệp .env đã được .gitignore, không commit lên repository.

# Cổng lắng nghe của web server
PORT=3000

# Môi trường chạy: development | production | test
NODE_ENV=development

# Khoá ký cookie session — bắt buộc đổi thành chuỗi ngẫu nhiên dài khi chạy thật
SESSION_SECRET=change-me-to-a-long-random-string
